{
  "name": "dhol",
  "private": true,
  "workspaces": [
    "fronted",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:shared": "npm --workspace packages/shared test",
    "test:fronted": "npm --workspace fronted test",
    "test:realtime": "npm --workspace apps/realtime test",
    "check:selectors": "npm --workspace fronted run check:zustand-selectors",
    "test": "npm run test:shared && npm run test:fronted && npm run test:realtime",
    "check": "npm run test && npm run check:selectors",
    "fronted:dev": "npm --workspace fronted run dev",
    "fronted:build": "npm --workspace fronted run build",
    "fronted:lint": "npm --workspace fronted run lint",
    "realtime:dev": "npm --workspace apps/realtime run dev",
    "realtime:deploy": "npm --workspace apps/realtime run deploy",
    "realtime:typecheck": "npm --workspace apps/realtime run typecheck",
    "build": "npm run fronted:build && npm run realtime:typecheck"
  }
}
